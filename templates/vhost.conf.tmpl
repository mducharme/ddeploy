server {
    # Ubuntu 24.04 ships nginx 1.24, which predates the standalone
    # "http2 on;" directive (nginx 1.25.1+) — HTTP/2 is enabled via the
    # "ssl http2" listen-directive flag instead, or `nginx -t` rejects
    # the whole vhost with "unknown directive http2" (confirmed against
    # a real Ubuntu 24.04 nginx package).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{SERVER_NAMES}};
    root {{ROOT}};
    index index.php;
{{AUTH_BLOCK}}
    ssl_certificate     /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/{{NAME}}.sock;
        fastcgi_param HTTP_PROXY "";
    }
    location ~ /\.(?!well-known) { deny all; }
}
server {
    listen 80;
    listen [::]:80;
    server_name {{SERVER_NAMES}};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
        default_type "text/plain";
    }
    location / { return 301 https://$host$request_uri; }
}
