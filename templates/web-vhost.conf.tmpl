server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{HOSTNAME}};
    ssl_certificate     /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    # Database dump uploads (`ddeploy api run start db-import`): large,
    # streamed straight through to the app rather than buffered to disk
    # by nginx first. ddeploy re-checks the size limit itself.
    location ~ ^/api/servers/[^/]+/sites/[^/]+/db/import$ {
        client_max_body_size {{IMPORT_MAX}};
        proxy_request_buffering off;
        proxy_read_timeout 6h;
        proxy_send_timeout 6h;
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        # Server-sent events (live run output, log follow): no buffering,
        # and long enough a read timeout for a slow build step.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
server {
    listen 80;
    listen [::]:80;
    server_name {{HOSTNAME}};
    location / { return 301 https://$host$request_uri; }
}
